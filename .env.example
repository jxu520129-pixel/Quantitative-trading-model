# 运行安全：即使设置 LIVE，仍必须设置 ENABLE_LIVE_TRADING=true 并实现实盘适配器。
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
DATABASE_PATH=data/ashare_quant.db
QUANT_CONFIG=config/default.yaml

# 写入前请轮换任何曾粘贴到聊天或日志中的令牌。
TUSHARE_TOKEN=

# 此项留空时，Streamlit 操作控件将保持禁用状态。
DASHBOARD_PASSWORD=请在本机修改为强密码

# 可选：企业微信机器人 Webhook。
WECOM_WEBHOOK=

# 可选：使用 SSL 的 SMTP 邮件。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# 仅供后续实盘适配器使用；V1 模拟盘请保持为空。
QMT_ACCOUNT_ID=
QMT_USERDATA_PATH=
PTRADE_ACCOUNT_ID=
