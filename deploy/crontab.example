# 内置调度器的替代方案，请勿与内置调度器同时运行。
35 9 * * 1-5 cd /opt/ashare-quant && .venv/bin/python -m ashare_quant.cli execute-orders >> logs/cron.log 2>&1
20 15 * * 1-5 cd /opt/ashare-quant && .venv/bin/python -m ashare_quant.cli after-close >> logs/cron.log 2>&1
35 15 * * 1-5 cd /opt/ashare-quant && .venv/bin/python -m ashare_quant.cli end-of-day >> logs/cron.log 2>&1
